LLM_PROVIDER=ollama

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-1.5-pro

SPARQL_ENDPOINT=https://api.linkeddata.cultureelerfgoed.nl/datasets/rce/cho/sparql

FLASK_PORT=5000
FLASK_DEBUG=false

# Bescherming tegen misbruik (belangrijk bij een publieke deploy, bv. Render)
MAX_QUESTION_LENGTH=500
# Leeg = uitgeschakeld. Vul in om een toegangscode te verplichten (frontend vraagt er dan om).
APP_ACCESS_CODE=
RATE_LIMIT_LLM=10/minute;100/day
RATE_LIMIT_SPARQL=30/minute;300/day

# Error tracking (Sentry). Leeg = uitgeschakeld.
SENTRY_DSN=